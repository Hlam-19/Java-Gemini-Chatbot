# ====== Gemini API ======
# Lay key tai: https://aistudio.google.com/apikey
GEMINI_API_KEY=dan_api_key_cua_ban_vao_day
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# ====== Web server ======
SERVER_PORT=8080

# ====== Database (MySQL) ======
DB_URL=jdbc:mysql://localhost:3306/chatbot_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
DB_USER=root
DB_PASSWORD=

# ====== Redis (cache + phien dang nhap) ======
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Han dung phien dang nhap (giay) - mac dinh 7 ngay
SESSION_TTL_SECONDS=604800
# So tin nhan toi da moi phut cho mot nguoi dung
RATE_LIMIT_PER_MINUTE=20
# Thoi gian song cua cache (giay)
CACHE_HISTORY_TTL=3600
CACHE_REPLY_TTL=86400

# ====== Chi dung khi chay bang docker-compose ======
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=chatbot_db
MYSQL_EXTERNAL_PORT=3307
REDIS_EXTERNAL_PORT=6379

# ====== Upload file ======
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10
