INSERT INTO MESSAGES VALUES(17,5,'model','\u0110\u1ecbnh lu\u1eadt 1 Newton kh\u1eb3ng \u0111\u1ecbnh m\u1ed9t v\u1eadt s\u1ebd gi\u1eef nguy\u00ean tr\u1ea1ng th\u00e1i \u0111\u1ee9ng y\u00ean ho\u1eb7c chuy\u1ec3n \u0111\u1ed9ng th\u1eb3ng \u0111\u1ec1u n\u1ebfu kh\u00f4ng ch\u1ecbu l\u1ef1c n\u00e0o t\u00e1c d\u1ee5ng (ho\u1eb7c h\u1ee3p l\u1ef1c b\u1eb1ng 0). \u0110i\u1ec1u n\u00e0y th\u1ec3 hi\u1ec7n t\u00ednh qu\u00e1n t\u00ednh, t\u1ee9c l\u00e0 m\u1ecdi v\u1eadt \u0111\u1ec1u c\u00f3 xu h\u01b0\u1edbng ch\u1ed1ng l\u1ea1i s\u1ef1 thay \u0111\u1ed5i tr\u1ea1ng th\u00e1i chuy\u1ec3n \u0111\u1ed9ng v\u1ed1n c\u00f3 c\u1ee7a n\u00f3.','2026-09-22 20:41:15.324903')
