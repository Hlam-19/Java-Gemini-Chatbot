INSERT INTO MESSAGES VALUES(27,10,'model','M\u1ed9t v\u1eadt s\u1ebd gi\u1eef nguy\u00ean tr\u1ea1ng th\u00e1i \u0111\u1ee9ng y\u00ean ho\u1eb7c chuy\u1ec3n \u0111\u1ed9ng th\u1eb3ng \u0111\u1ec1u m\u00e3i m\u00e3i n\u1ebfu kh\u00f4ng ch\u1ecbu l\u1ef1c n\u00e0o t\u00e1c d\u1ee5ng (ho\u1eb7c h\u1ee3p l\u1ef1c t\u00e1c d\u1ee5ng l\u00ean n\u00f3 b\u1eb1ng 0). \u000a\u000a\u0110\u1ecbnh lu\u1eadt n\u00e0y th\u1ec3 hi\u1ec7n t\u00ednh qu\u00e1n t\u00ednh, ngh\u0129a l\u00e0 m\u1ecdi v\u1eadt \u0111\u1ec1u c\u00f3 xu h\u01b0\u1edbng t\u1ef1 b\u1ea3o to\u00e0n v\u00e0 ch\u1ed1ng l\u1ea1i s\u1ef1 thay \u0111\u1ed5i tr\u1ea1ng th\u00e1i chuy\u1ec3n \u0111\u1ed9ng c\u1ee7a m\u00ecnh.','2026-09-22 20:54:22.500964')
